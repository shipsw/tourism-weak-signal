# ===== LLM 配置（OpenAI 兼容接口）=====
# 支持：OpenAI / DeepSeek / Moonshot(Kimi) / Qwen / Ollama(本地)

# API 地址（Ollama 本地示例：http://localhost:11434/v1）
LLM_BASE_URL=https://api.deepseek.com/v1

# API Key（Ollama 本地可留空）
LLM_API_KEY=sk-your-key-here

# 模型名（DeepSeek: deepseek-chat；Kimi: moonshot-v1-8k；Qwen: qwen-plus；Ollama: qwen2.5:7b）
LLM_MODEL=deepseek-chat

# ===== Reddit 官方 API（可选，免费档）=====
# 在 https://www.reddit.com/prefs/apps 创建应用（script 类型）后填入。
# 不配置则使用匿名请求（可能被 403 限流）。
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ===== SerpApi（真实 Google 搜索：抓 X/Instagram/Facebook 等社媒）=====
# 在 https://serpapi.com/manage-api-key 获取；按次计费，daily_budget 防超额。
SERPAPI_API_KEY=

# ===== YouTube Data API v3（游客 Vlog + 评论，免费 1 万单位/天/Key）=====
# 在 Google Cloud Console 启用 YouTube Data API v3 后创建 API Key。
# 多个 key 用英文逗号分隔，自动轮换规避每日配额。
YOUTUBE_API_KEYS=
